<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="800"
      Title="AccountsPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <Border Height="196" CornerRadius="8" ClipToBounds="True"
                Background="{Binding BannerBrush, Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="18,16,12,16" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="68" Height="68" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding BustImage, Mode=OneWay}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>

                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="24" FontWeight="SemiBold"
                                       Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                            <TextBlock Text="{Binding UsernameLine}" FontSize="13" Margin="0,2,0,0"
                                       Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                            <TextBlock Text="{Binding MetaLine}" FontSize="12" Margin="0,8,0,0"
                                       Foreground="#B3FFFFFF" TextWrapping="Wrap" MaxWidth="440" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Image Grid.Column="1" Source="{Binding FullBodyImage, Mode=OneWay}"
                       Stretch="Uniform" StretchDirection="DownOnly"
                       Height="180" Margin="0,10,16,0" VerticalAlignment="Bottom"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </Border>

        <TextBlock Margin="2,8,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="13"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasStatusMessage}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <controls:OptionControl Header="Account access" Margin="0,14,0,0"
                                Visibility="{Binding AccessPromptVisibility}"
                                Description="{Binding CookieHint}">
            <ui:ToggleSwitch IsChecked="{Binding CookieAccess, Mode=TwoWay}" />
        </controls:OptionControl>

        <StackPanel Margin="0,16,0,0" DataContext="{Binding Wardrobe}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Wardrobe" FontSize="20" FontWeight="Medium" VerticalAlignment="Center" />
                <ui:Button Grid.Column="1" Icon="ArrowSync24" Content="Reload"
                           Visibility="{Binding GroupsVisibility}"
                           Command="{Binding RefreshCommand, Mode=OneTime}" />
            </Grid>

            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Status}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <StackPanel Visibility="{Binding GroupsVisibility}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                    <ListBox ItemsSource="{Binding Tabs, Mode=OneWay}"
                             SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="TabRoot" CornerRadius="6" Padding="12,7" Margin="0,0,4,0"
                                                    Background="Transparent" Cursor="Hand">
                                                <StackPanel>
                                                    <TextBlock x:Name="TabLabel" Text="{Binding Name}" FontSize="13"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <Border x:Name="TabUnderline" Height="2" CornerRadius="1" Margin="0,6,0,0"
                                                            Background="Transparent" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabRoot" Property="Background"
                                                            Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TabLabel" Property="Foreground"
                                                            Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <Setter TargetName="TabLabel" Property="FontWeight" Value="SemiBold" />
                                                    <Setter TargetName="TabUnderline" Property="Background"
                                                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </ScrollViewer>

                <TextBlock Margin="2,10,0,0" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{Binding SelectedTab.CountLabel}" />

                <ItemsControl ItemsSource="{Binding SelectedTab.Visible, Mode=OneWay}" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="104" Height="122" Margin="0,0,6,6" Padding="0" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0"
                                    AutomationProperties.Name="{Binding Label}"
                                    ToolTip="{Binding Label}"
                                    Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Tile" CornerRadius="6" Padding="4" BorderThickness="2"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Image Grid.Row="0" Source="{Binding Thumbnail, Mode=OneWay}"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                                <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="10" Margin="2,4,2,0"
                                                           TextTrimming="CharacterEllipsis" MaxHeight="26"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                                <Border Grid.Row="0" Width="20" Height="20" CornerRadius="10"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                        Visibility="{Binding WornVisibility}">
                                                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="12" Foreground="White" />
                                                </Border>

                                                <Border Grid.Row="0" CornerRadius="9" Padding="7,2"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                        Visibility="{Binding BadgeVisibility}">
                                                    <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Tile" Property="BorderBrush"
                                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Worn}" Value="True">
                                                <Setter TargetName="Tile" Property="BorderBrush"
                                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:Button HorizontalAlignment="Left" Margin="0,4,0,0" Icon="Add24"
                           Content="{Binding SelectedTab.MoreLabel}"
                           Visibility="{Binding SelectedTab.MoreVisibility}"
                           Command="{Binding ShowMoreCommand, Mode=OneTime}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:UiPage>
